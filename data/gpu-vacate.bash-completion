# bash completion for gpu-vacate. bash-completion loads it on first use from
# $PREFIX/share/bash-completion/completions/gpu-vacate.
_gpu_vacate() {
  local cur=${COMP_WORDS[COMP_CWORD]}
  COMPREPLY=()
  if (( COMP_CWORD == 2 )) && [[ ${COMP_WORDS[1]} == @(on|igpu) ]]; then
    mapfile -t COMPREPLY < <(compgen -W '--keep' -- "$cur")
    return 0
  fi
  (( COMP_CWORD == 1 )) || return 0
  # firmware-input and restore are for the systemd services; igpu/dgpu are aliases of on/off
  mapfile -t COMPREPLY < <(compgen -W 'status on off inputs sync version help' -- "$cur")
}
complete -F _gpu_vacate gpu-vacate
