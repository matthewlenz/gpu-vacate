# Points the monitor at the boot GPU's input at boot (before the login screen) and at
# shutdown (after it), so the firmware, boot loader and other OSes are visible.
[Unit]
Description=Switch the monitor to the boot GPU's input at boot and shutdown (gpu-vacate)
After=systemd-modules-load.service
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
# ddcutil keeps per-monitor timing data in the XDG cache, and root services have no home
CacheDirectory=gpu-vacate
Environment=XDG_CACHE_HOME=%C/gpu-vacate
ExecStart=@BINDIR@/gpu-vacate firmware-input
ExecStop=@BINDIR@/gpu-vacate firmware-input
TimeoutSec=45

[Install]
WantedBy=graphical.target
