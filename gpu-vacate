#!/usr/bin/env bash
# gpu-vacate: move the GNOME desktop off the discrete GPU, so all of it is free for
# compute, and back again. See README.md.
#
# How it works: a udev rule tags the GPU named by a flag file in /run/gpu-vacate as
# mutter's preferred primary GPU, and a systemd path unit re-runs udev when the flag
# changes. Mutter picks its render GPU at login, so a switch needs a log out/in. The
# output on the other GPU is turned off with gdctl, and the monitor is pointed at the
# right input over DDC/CI (ddcutil). The flag lives in /run, so every boot starts normal,
# unless `on --keep` left a mark in /var/lib/gpu-vacate: then a boot service recreates it.
set -euo pipefail

VERSION=0.1.0
CONF=${GPU_VACATE_CONF:-/etc/gpu-vacate.conf}
RUNDIR=/run/gpu-vacate
STATEDIR=/var/lib/gpu-vacate
KEEP=$STATEDIR/keep
TAG=mutter-device-preferred-primary

# Defaults; see gpu-vacate.conf
DESKTOP_GPU=
INPUT_DGPU=
INPUT_IGPU=
FIRMWARE_INPUT=yes
# shellcheck source=data/gpu-vacate.conf
[[ -r $CONF ]] && . "$CONF"

usage() {
  cat <<EOF
Usage: gpu-vacate COMMAND [--keep]

  status    show the mode, the GPU the session renders on, and each GPU's VRAM use
  on        render the desktop on the iGPU and leave the discrete GPU(s) idle
            --keep: stay vacated across reboots, until \`gpu-vacate off'
  off       render the desktop on the dGPU again
  inputs    show each connected output's DDC/CI bus and the monitor's current input
            code (for INPUT_DGPU and INPUT_IGPU in $CONF)
  sync      re-apply the outputs and monitor input for the current mode (runs at login)
  version   print the version

Switching needs a log out and back in. Settings: $CONF
See gpu-vacate(1) for details.
EOF
}

die() { echo "gpu-vacate: $*" >&2; exit 1; }
warn() { echo "gpu-vacate: $*" >&2; }

# DRM cards (card0, card1, ...), not their connectors
cards() {
  local c
  for c in /sys/class/drm/card[0-9]*; do
    [[ ${c##*/} == *-* ]] || echo "${c##*/}"
  done
}

dev() { echo "/sys/class/drm/$1/device"; }
pci_slot() { local d; d=$(readlink -f "$(dev "$1")"); echo "${d##*/}"; }
pci_id() { local d; d=$(dev "$1"); echo "$(<"$d/vendor"):$(<"$d/device")" | sed 's/0x//g'; }
is_boot_gpu() { [[ $(cat "$(dev "$1")/boot_vga" 2>/dev/null) == 1 ]]; }
other() { [[ $1 == igpu ]] && echo dgpu || echo igpu; }

# Intel's iGPU always sits at 00:02.0. An AMD APU has no VRAM chips (no
# mem_info_vram_vendor) and no option ROM of its own (its VBIOS is in the system firmware).
is_integrated() {
  local d; d=$(dev "$1")
  case $(<"$d/vendor") in
    0x8086) [[ $(pci_slot "$1") == 0000:00:02.0 ]] ;;
    0x1002) [[ ! -e $d/mem_info_vram_vendor && ! -e $d/rom ]] ;;
    *) return 1 ;;
  esac
}

# The GPU the desktop moves to: DESKTOP_GPU if set, else the one integrated GPU
desktop_card() {
  local c slot want=${DESKTOP_GPU,,} found=()
  for c in $(cards); do
    if [[ -n $want ]]; then
      slot=$(pci_slot "$c")
      [[ $want == "$(pci_id "$c")" || $want == "$slot" || $want == "${slot#0000:}" ]] || continue
    else
      is_integrated "$c" || continue
    fi
    found+=("$c")
  done
  case ${#found[@]} in
    1) echo "${found[0]}" ;;
    0) [[ -n $want ]] && die "no GPU matches DESKTOP_GPU=$DESKTOP_GPU (in $CONF)"
       die "no integrated GPU found; is it enabled in the BIOS? (or set DESKTOP_GPU in $CONF)" ;;
    *) die "several GPUs match (${found[*]}); set DESKTOP_GPU in $CONF (see: gpu-vacate status)" ;;
  esac
}

# The GPU the desktop normally runs on: the one the firmware boots on, unless that's
# the desktop GPU, then the first other GPU with a monitor connected
main_card() {
  local desk=$1 c
  for c in $(cards); do
    [[ $c != "$desk" ]] && is_boot_gpu "$c" && { echo "$c"; return; }
  done
  for c in $(cards); do
    [[ $c != "$desk" ]] && connected_output "$c" >/dev/null && { echo "$c"; return; }
  done
  return 1
}

# Card for a mode: igpu = the desktop GPU, dgpu = the main GPU
card_for() {
  local desk
  desk=$(desktop_card) || exit 1
  if [[ $1 == igpu ]]; then
    echo "$desk"
  else
    main_card "$desk" || die "no GPU found besides $desk"
  fi
}

# Print the sysfs path of the first connected output on a card, DP preferred
connected_output() {
  local s
  for s in /sys/class/drm/"$1"-DP-* /sys/class/drm/"$1"-HDMI-A-* /sys/class/drm/"$1"-DVI-*; do
    [[ -e $s && $(<"$s/status") == connected ]] || continue
    echo "$s"
    return
  done
  return 1
}

# Kernel "card2-HDMI-A-5" is "HDMI-5" in mutter; DP names are the same
mutter_name() { local s=${1##*/}; s=${s#*-}; echo "${s/HDMI-A-/HDMI-}"; }

vacated() { compgen -G "$RUNDIR/card*" >/dev/null; }
kept() { [[ -e $KEEP ]]; }
current_mode() { vacated && echo igpu || echo dgpu; }

primary_scale() {
  gdctl show 2>/dev/null | awk '
    /Logical monitor/ { s = ""; p = 0 }
    /Scale:/          { s = $NF }
    /Primary: yes/    { p = 1 }
    /Monitors:/       { if (p && s != "") { print s; exit } }'
}

# Largest resolution an output offers, then highest refresh rate, e.g. 5120x1440@143.987.
# Only modes with the panel's aspect ratio count (taken from the kernel's preferred
# mode, the first line of the connector's "modes" file), so 16:9 TV modes are skipped.
best_mode() {
  local out=$1 native
  native=$(head -1 "$2/modes")
  gdctl show --modes 2>/dev/null | awk -v out="$out" -v native="$native" '
    BEGIN { split(native, n, "x"); aspect = n[1] / n[2] }
    /Monitor / { cur = $0 ~ ("Monitor " out " ") }
    cur && match($0, /[0-9]+x[0-9]+@[0-9.]+/) {
      m = substr($0, RSTART, RLENGTH); split(m, a, /[x@]/)
      r = a[1] / a[2] / aspect
      if (r < 0.99 || r > 1.01) next
      if (a[1] * a[2] > area || (a[1] * a[2] == area && a[3] + 0 > hz)) {
        area = a[1] * a[2]; hz = a[3] + 0; best = m
      }
    }
    END { print best }'
}

# True if the only logical monitor is $1 running mode $2
layout_is() {
  gdctl show 2>/dev/null | awk -v out="$1" -v res="$2" '
    /Monitor / && !/Logical/ { cur = $0 ~ ("Monitor " out " ") }
    cur && /Current mode/    { getline; if (index($0, res)) mode_ok = 1 }
    /Logical monitor #/      { n++ }
    /Logical monitors:/      { inlog = 1 }
    inlog && /└──|├──/ && $0 ~ (out " \\(") { listed = 1 }
    END { exit !(n == 1 && listed && mode_ok) }'
}

# Enable only the output belonging to the given mode's GPU.
# persistent: saved to monitors.xml; GNOME shows a "keep these settings?" countdown.
# temporary:  this session only, no dialog.
apply_outputs() {
  local mode=$1 method=$2 card conn out scale res
  card=$(card_for "$mode")
  conn=$(connected_output "$card") || die "nothing is connected to the $mode ($card)"
  out=$(mutter_name "$conn")
  res=$(best_mode "$out" "$conn")
  # Only sync may skip: sync's temporary fix at login makes the layout look right without
  # saving it, so a persistent apply must always run or monitors.xml stays stale.
  if [[ $method == temporary && -n $res ]] && layout_is "$out" "$res"; then
    echo "Display output: $out ($mode), $res, already set"
    return 1
  fi
  scale=$(primary_scale); scale=${scale:-1}
  local flags=()
  [[ $method == persistent ]] && flags+=(--persistent)
  gdctl set "${flags[@]}" --logical-monitor --primary --scale "$scale" --monitor "$out" ${res:+--mode "$res"}
  echo "Display output: $out on $card ($mode), ${res:-default mode}, scale $scale"
}

# I2C bus number for a connector: DP's AUX channel bus, else the HDMI/DVI DDC bus
ddc_bus() {
  local b
  for b in "$1"/i2c-*; do [[ -e $b ]] && { echo "${b##*i2c-}"; return; }; done
  [[ -e $1/ddc ]] && b=$(readlink -f "$1/ddc") && echo "${b##*i2c-}"
}

# Set the monitor's input (VCP 0x60) over the first of the given buses that answers.
# Right after a mode change (e.g. at login) the monitor can ACK a write and ignore it,
# so keep going until it reads back the wanted input. Returns 1 if it never does.
set_input() {
  local want=${1,,} bus cur i
  shift
  for i in {1..10}; do
    for bus; do
      cur=$(ddcutil --bus "$bus" getvcp 60 2>/dev/null | grep -o 'sl=0x[0-9a-f]*') || continue
      if [[ ${cur#sl=} == "$want" ]]; then
        (( i == 1 )) || echo "Monitor input set to $want (try $i)"
        return 0
      fi
      ddcutil --bus "$bus" setvcp 60 "$want" >/dev/null 2>&1 && break
    done
    sleep 1
  done
  warn "monitor input still isn't $want after 10 tries"
  return 1
}

# Point the monitor at the given mode's input. Both cables go to the same monitor, so
# use the target GPU's bus first, then the other's. Returns 2 if there's no input code
# or no ddcutil, 1 if the monitor didn't switch.
switch_input() {
  local mode=$1 want m card conn bus buses=()
  [[ $mode == igpu ]] && want=$INPUT_IGPU || want=$INPUT_DGPU
  [[ -n $want ]] && command -v ddcutil >/dev/null || return 2
  for m in "$mode" "$(other "$mode")"; do
    card=$(card_for "$m" 2>/dev/null) && conn=$(connected_output "$card") &&
      bus=$(ddc_bus "$conn") && buses+=("$bus")
  done
  (( ${#buses[@]} )) || return 2
  set_input "$want" "${buses[@]}"
}

has_tag() { udevadm info "/dev/dri/$1" 2>/dev/null | grep -q "^E: CURRENT_TAGS=.*:$TAG:"; }

wait_for_tag() {
  local mode=$1 card=$2 want=no has i
  [[ $mode == igpu ]] && want=yes
  for i in {1..20}; do
    has=no
    has_tag "$card" && has=yes
    [[ $has == "$want" ]] && return 0
    sleep 0.25
  done
  die "udev didn't pick up the change; is gpu-vacate-trigger.path running? (systemctl status gpu-vacate-trigger.path)"
}

# The card gnome-shell renders with (the one whose render node it holds)
session_card() {
  local pid c node fd held=()
  pid=$(pgrep -u "${USER:-$(id -un)}" -x gnome-shell | head -1) || return 1
  [[ -n $pid ]] || return 1
  for fd in /proc/"$pid"/fd/*; do
    held+=("$(readlink "$fd" 2>/dev/null)")
  done
  for c in $(cards); do
    for node in "$(dev "$c")"/drm/renderD*; do
      [[ " ${held[*]} " == *" /dev/dri/${node##*/} "* ]] && { echo "$c"; return; }
    done
  done
  return 1
}

cmd_status() {
  local desk main sess c d role vram conns s
  desk=$(desktop_card 2>&1) || { echo "${desk#gpu-vacate: }"; desk=; }
  main=
  [[ -n $desk ]] && { main=$(main_card "$desk") || main=; }
  sess=$(session_card) || sess=
  if vacated; then
    echo "Mode:             vacated (desktop on the iGPU)$(kept && echo ', kept across reboots')"
  elif kept; then
    echo "Mode:             normal (desktop on the dGPU), but set to vacate at boot"
    echo "                  (the boot restore failed? journalctl -b -u gpu-vacate-restore)"
  else
    echo "Mode:             normal (desktop on the dGPU)"
  fi
  if [[ -z $sess ]]; then
    echo "Session renders:  unknown (no gnome-shell found)"
  else
    echo "Session renders:  $sess$([[ $sess != "$(card_for "$(current_mode)" 2>/dev/null)" ]] && echo '  (log out/in to apply)')"
  fi
  echo
  for c in $(cards); do
    d=$(dev "$c")
    role=other
    [[ $c == "$desk" ]] && role=iGPU
    [[ $c == "$main" ]] && role=dGPU
    if [[ $(cat "$d/power/runtime_status" 2>/dev/null) == suspended ]]; then
      vram="suspended"            # reading its VRAM use would wake it up
    elif [[ -r $d/mem_info_vram_used ]]; then
      vram="$(( $(<"$d/mem_info_vram_used") / 1048576 )) MiB VRAM used"
    else
      vram="VRAM use n/a"
    fi
    conns=
    for s in /sys/class/drm/"$c"-*; do
      [[ $(<"$s/status") == connected ]] && conns+="$(mutter_name "$s") "
    done
    printf '%-6s %-5s %s [%s] %s, %s, connected: %s\n' "$c" "$role" "$(pci_slot "$c")" \
      "$(pci_id "$c")" "$(basename "$(readlink -f "$d/driver")")" "$vram" "${conns:-none}"
  done
  [[ -d $RUNDIR ]] || printf '\nNot installed (%s is missing): sudo make install\n' "$RUNDIR"
}

cmd_inputs() {
  local c s bus cur
  command -v ddcutil >/dev/null || die "ddcutil isn't installed"
  for c in $(cards); do
    for s in /sys/class/drm/"$c"-*; do
      [[ $(<"$s/status") == connected ]] || continue
      bus=$(ddc_bus "$s") || bus=
      cur=
      [[ -n $bus ]] && cur=$(ddcutil --bus "$bus" getvcp 60 2>/dev/null | grep -o 'sl=0x[0-9a-f]*') && cur=${cur#sl=}
      printf '%-18s i2c-%-4s current input: %s\n' "${s##*/}" "${bus:-?}" "${cur:-no answer}"
    done
  done
  cat <<EOF

This is the input the monitor is showing now. Switch the monitor to its other input
(from its own menu), run this again to read that code, then set INPUT_DGPU and
INPUT_IGPU in $CONF.
EOF
}

cmd_switch() {
  local target=$1 keep=$2 desk card ans
  command -v gdctl >/dev/null || die "gdctl not found; gpu-vacate needs GNOME 48 or newer"
  [[ ${XDG_SESSION_TYPE:-} == wayland ]] || warn "not a Wayland session; gpu-vacate only works with GNOME on Wayland"
  [[ -d $RUNDIR ]] || die "$RUNDIR is missing; install gpu-vacate first (sudo make install)"
  [[ -w $RUNDIR ]] || die "can't write to $RUNDIR; join the gpu-vacate group (sudo usermod -aG gpu-vacate $USER) and log in again"
  if [[ $keep == yes && ! -w $STATEDIR ]]; then
    [[ -d $STATEDIR ]] || die "$STATEDIR is missing; reinstall gpu-vacate (sudo make install)"
    die "can't write to $STATEDIR; join the gpu-vacate group and log in again"
  fi
  desk=$(desktop_card)
  card=$(card_for "$target")
  connected_output "$card" >/dev/null ||
    die "nothing is connected to the $target ($card); refusing to switch to a blank screen"

  rm -f "$RUNDIR"/card*
  if [[ $target == igpu ]]; then touch "$RUNDIR/$desk"; fi
  set_keep "$keep" "$target"
  wait_for_tag "$target" "$desk"
  if apply_outputs "$target" persistent; then
    # GNOME only saves the layout once it's confirmed; logging out first discards it
    echo
    if switch_input "$target"; then
      echo "Monitor switched to the $target's input. Click \"Keep Changes\" in the dialog."
    else
      echo "Switch the monitor's input, then click \"Keep Changes\" in the dialog."
    fi
    read -rp "Press Enter once you've clicked it... " _
  else
    switch_input "$target" || echo "Couldn't switch the monitor's input; switch it by hand."
  fi

  if [[ $(session_card) == "$card" ]]; then
    echo "Already rendering on the $target."
    exit 0
  fi
  echo "Log out and back in to move rendering to the $target."
  read -rp "Log out now? Unsaved work in open apps will be lost. [y/N] " ans
  if [[ $ans == [yY] ]]; then gnome-session-quit --logout --no-prompt; fi
}

# Remember (or forget) to vacate again at the next boot; see cmd_restore
set_keep() {
  if [[ $1 == yes ]]; then
    touch "$KEEP" || die "can't write $KEEP"
    echo "Vacated mode is kept across reboots, until: gpu-vacate off"
  else
    if kept; then rm -f "$KEEP" || die "can't remove $KEEP"; fi
    [[ $2 == igpu ]] && echo "Vacated until the next reboot (gpu-vacate on --keep to keep it)"
  fi
  return 0
}

# Runs as root from gpu-vacate-restore.service at boot, before the login screen, when
# `gpu-vacate on --keep` left $KEEP behind: recreate the flag in /run so GDM and the
# session render on the desktop GPU. Card numbers can change between boots, so the card
# is found again here. Always succeeds, so the login screen still starts.
cmd_restore() {
  local desk='' i
  kept || return 0
  # At boot the GPU drivers may still be probing
  for i in {1..15}; do
    desk=$(desktop_card 2>/dev/null) && connected_output "$desk" >/dev/null && break
    desk=
    sleep 1
  done
  if [[ -z $desk ]]; then
    echo "No desktop GPU with a monitor connected found; starting in normal mode"
    return 0
  fi
  mkdir -p "$RUNDIR"
  rm -f "$RUNDIR"/card*
  touch "$RUNDIR/$desk"
  udevadm trigger --settle --subsystem-match=drm --sysname-match='card[0-9]*' --action=change
  echo "Vacated mode kept: the desktop renders on $desk"
}

# Runs as root from gpu-vacate-firmware-input.service: point the monitor at the boot
# GPU's input before the login screen starts ("boot") and after it stops ("shutdown"),
# since the firmware, boot loader and other OSes only show on the boot GPU. If the boot
# restored a kept vacated mode, the boot run points it at the desktop GPU's input instead.
# Always succeeds: if the boot run failed, systemd would skip the shutdown run.
cmd_firmware_input() {
  local phase=${1:-shutdown} c boot='' conn bus='' desk dconn dbus want i
  [[ $FIRMWARE_INPUT == yes ]] || return 0
  # Only a manual (re)start or stop of the service, e.g. by make install/uninstall, can
  # find a vacated desktop still running (a real boot starts with an empty /run, and at
  # shutdown the display manager is already stopped). Don't blank it.
  if vacated && systemctl -q is-active display-manager.service; then
    echo "The desktop is vacated and running; leaving the monitor input alone"
    return 0
  fi
  command -v ddcutil >/dev/null || { echo "ddcutil isn't installed"; return 0; }
  modprobe i2c-dev 2>/dev/null
  # At boot the GPU driver may still be probing
  for i in {1..15}; do
    for c in $(cards); do is_boot_gpu "$c" && boot=$c; done
    if [[ -n $boot ]] && conn=$(connected_output "$boot") && bus=$(ddc_bus "$conn") &&
       [[ -e /dev/i2c-$bus ]]; then
      break
    fi
    bus=
    sleep 1
  done
  [[ -n $bus ]] || { echo "No monitor found on the boot GPU; leaving the input alone"; return 0; }
  desk=$(desktop_card 2>/dev/null) || desk=
  if [[ $phase == boot && -n $desk ]] && vacated; then
    # Same monitor on both cables: ask over the desktop GPU's bus first
    [[ -n $INPUT_IGPU ]] || { echo "No input code set in $CONF; leaving the input alone"; return 0; }
    local buses=("$bus")
    dconn=$(connected_output "$desk") && dbus=$(ddc_bus "$dconn") && buses=("$dbus" "$bus")
    set_input "$INPUT_IGPU" "${buses[@]}" &&
      echo "Vacated mode kept: monitor on the desktop GPU's input ($INPUT_IGPU)"
    return 0
  fi
  [[ $boot == "$desk" ]] && want=$INPUT_IGPU || want=$INPUT_DGPU
  [[ -n $want ]] || { echo "No input code set in $CONF; leaving the input alone"; return 0; }
  set_input "$want" "$bus" && echo "Monitor on the boot GPU's input ($want, $(mutter_name "$conn"))"
  return 0
}

keep=no
case ${1:-} in
  on|igpu)
    case ${2:-} in
      '') ;;
      -k|--keep) keep=yes ;;
      *) usage >&2; exit 1 ;;
    esac
    (( $# <= 2 )) || { usage >&2; exit 1; } ;;
  off|dgpu) (( $# == 1 )) || { usage >&2; exit 1; } ;;
esac

case ${1:-status} in
  status) cmd_status ;;
  on|igpu) cmd_switch igpu "$keep" ;;
  off|dgpu) cmd_switch dgpu no ;;
  inputs) cmd_inputs ;;
  sync)
    # Runs at login: fix the layout only if it's wrong, without the confirmation dialog
    command -v gdctl >/dev/null || exit 0
    apply_outputs "$(current_mode)" temporary || true
    switch_input "$(current_mode)" || true
    ;;
  firmware-input) cmd_firmware_input "${2:-}" || true ;;
  restore) cmd_restore || true ;;
  version|--version) echo "gpu-vacate $VERSION" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 1 ;;
esac
